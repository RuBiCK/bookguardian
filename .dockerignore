node_modules
**/node_modules
**/dist
**/coverage
**/dev-dist
apps/web/test-results
apps/web/playwright-report
apps/web/blob-report
apps/web/playwright

# Local state and secrets never enter the image.
data
apps/api/data
.env
.env.*
!.env.example
*.log
.DS_Store

# Not needed to build or run.
.github
docs
Dockerfile
docker-compose.yaml
